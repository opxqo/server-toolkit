{
  "log": {"loglevel": "warning"},
  "outbounds": [
    {"tag": "direct", "protocol": "freedom", "settings": {}},
    {"tag": "blocked", "protocol": "blackhole", "settings": {}},
    {"tag": "residential-out", "protocol": "socks", "settings": {"servers": [{"address": "proxy.example", "port": 1080}]}}
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {"type": "field", "inboundTag": ["api"], "outboundTag": "api"},
      {"type": "field", "outboundTag": "blocked", "ip": ["geoip:private"]},
      {"type": "field", "outboundTag": "direct", "ip": ["geoip:cn"]},
      {"type": "field", "outboundTag": "direct", "domain": ["geosite:cn", "regexp:.*\\.cn$", "domain:keep.example"]},
      {"type": "field", "inboundTag": ["in-10001-tcp"], "outboundTag": "residential-out"},
      {"type": "field", "user": ["paused@example"], "outboundTag": "residential-out", "enabled": false},
      {"type": "field", "outboundTag": "blocked", "protocol": ["bittorrent"]}
    ]
  }
}
